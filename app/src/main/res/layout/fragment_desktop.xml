<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/header_bg" android:orientation="horizontal"
        android:paddingStart="4dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:elevation="4dp">
        <TextView android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="‹" android:textColor="@color/white"
            android:textSize="28sp" android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Modo escritorio" android:textColor="@color/white" android:textSize="17sp"
            android:textStyle="bold" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/btn_help" android:layout_width="36dp" android:layout_height="36dp"
            android:gravity="center" android:text="?" android:textColor="@color/white"
            android:textSize="15sp" android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <include layout="@layout/item_check_row" android:id="@+id/row_desktop_mode"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Establecer como app de inicio -->
            <LinearLayout android:id="@+id/row_set_as_home"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Establecer a Taskbar como aplicación de inicio"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Requerido para que funcione el modo de escritorio"
                        android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/muted"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Lanzador primario -->
            <LinearLayout android:id="@+id/row_primary_launcher"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Lanzador primario" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/val_primary_launcher"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Moto App Launcher" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <include layout="@layout/item_check_row" android:id="@+id/row_lock_phone_screen"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Input method fix -->
            <LinearLayout android:id="@+id/row_input_method_fix"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Enable input method fix" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Fixes visual glitches caused by input methods on Android 11+.\nRequires you to temporarily set Taskbar as your input method each time desktop mode starts."
                    android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Activar ajustes adicionales -->
            <LinearLayout android:id="@+id/row_extra_settings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Activar ajustes adicionales" android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Clic aquí para la información sobre cómo activar"
                        android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/muted"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Densidad de pantalla - Disabled -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:alpha="0.5">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Densidad de pantalla" android:textColor="@color/disabled_text" android:textSize="14sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Predeterminado" android:textColor="@color/disabled_text" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
