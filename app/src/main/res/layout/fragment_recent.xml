<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/header_bg" android:orientation="horizontal"
        android:paddingStart="4dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:elevation="4dp">
        <TextView android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="‹" android:textColor="@color/white"
            android:textSize="28sp" android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Últimas aplicaciones" android:textColor="@color/white" android:textSize="17sp"
            android:textStyle="bold" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Desactivar acceso a datos de uso -->
            <LinearLayout android:id="@+id/row_usage_access"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="(Des)activar el acceso a los datos de uso" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Requerido para aparecer las aplicaciones recientes"
                    android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Frecuencia de actualizacion -->
            <LinearLayout android:id="@+id/row_update_freq"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Frecuencia de actualización" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/val_update_freq"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="1 segundo" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Numero de apps en ejecucion -->
            <LinearLayout android:id="@+id/row_running_apps"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Número de aplicaciones en ejecución que se mostrarán..."
                    android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/val_running_apps"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Desde el último día" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Secuencia de clasificacion -->
            <LinearLayout android:id="@+id/row_sort_order"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Secuencia de clasificación" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/val_sort_order"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Último usado (descendente)" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Maximo de apps recientes -->
            <LinearLayout android:id="@+id/row_max_recent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ripple_bg" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Número máximo de aplicaciones recientes/ancladas"
                    android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/val_max_recent"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="10 aplicaciones" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Checks -->
            <include layout="@layout/item_check_row" android:id="@+id/row_hide_bg_icon"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
            <include layout="@layout/item_check_row" android:id="@+id/row_accelerate_switch"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
            <include layout="@layout/item_check_row" android:id="@+id/row_disable_scroll_list"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
            <include layout="@layout/item_check_row" android:id="@+id/row_expand_empty"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
            <include layout="@layout/item_check_row" android:id="@+id/row_center_icons"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
            <include layout="@layout/item_check_row" android:id="@+id/row_show_status_clock"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <!-- Disabled row - notificaciones -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/bg" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:gravity="center_vertical" android:alpha="0.5">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Mostrar recuento de notificaciones en el área de estado..."
                        android:textColor="@color/disabled_text" android:textSize="14sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Requiere acceso a la notificación"
                        android:textColor="@color/disabled_text" android:textSize="12sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <Switch android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:enabled="false" android:checked="false"
                    android:thumbTint="@color/disabled_text" android:trackTint="@color/check_off"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
